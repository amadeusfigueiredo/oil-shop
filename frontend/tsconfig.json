{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "dom"],
    "target": "esnext",
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "alwaysStrict": true,
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitReturns": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": true,
    "types": ["node", "vite/client", "vitest/globals", "vitest/jsdom"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "./declarations.d.ts",
    "./vite-env.d.ts",
    "./setupTests.ts",
    "./vite.config.ts"
  ],
  "exclude": ["node_modules/**/*"]
}
